{
  "name": "alt-hist-race-sim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "pnpm -r test",
    "test:changed": "pnpm -r test --changed --passWithNoTests",
    "test:watch": "pnpm -r --parallel test:watch",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @alt-hist/web dev",
    "build": "pnpm --filter @alt-hist/web build",
    "preview": "pnpm --filter @alt-hist/web preview",
    "calibrate": "pnpm --filter @alt-hist/calibrate start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "race": "pnpm --filter @alt-hist/calibrate race",
    "season": "pnpm --filter @alt-hist/calibrate season",
    "calibrate-season": "pnpm --filter @alt-hist/calibrate seasons",
    "retirements": "pnpm --filter @alt-hist/calibrate retirements",
    "progression": "pnpm --filter @alt-hist/calibrate progression",
    "tune": "pnpm --filter @alt-hist/calibrate tune",
    "fit": "pnpm --filter @alt-hist/calibrate fit",
    "screenshots": "pnpm --filter @alt-hist/screenshots start",
    "tunnel": "pnpm --filter @alt-hist/tunnel start"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
